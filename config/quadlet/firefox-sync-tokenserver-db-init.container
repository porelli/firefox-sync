[Unit]
Description=Firefox Sync - Tokenserver Database Initialization
After=firefox-sync-network.service firefox-sync-tokenserver-db.service firefox-sync-syncstorage-migrate.service
Requires=firefox-sync-tokenserver-db.service firefox-sync-syncstorage-migrate.service

[Container]
Image=%REPOSITORY%:%SYNCSTORAGE_INIT_IMAGE%-%SYNCSTORAGE_INIT_IMAGE_TAG%
ContainerName=firefox-sync-tokenserver-db-init
Network=firefox-sync-network.network

Environment=MARIADB_SERVER=firefox-sync-tokenserver-db
Environment=MARIADB_SERVER_PORT=3306
Environment=MARIADB_DATABASE=%MARIADB_TOKENSERVER_DATABASE%
Environment=MARIADB_USER=%MARIADB_TOKENSERVER_USER%
Environment=MARIADB_PASSWORD=%MARIADB_TOKENSERVER_PASSWORD%
Environment=MAX_USERS=%MAX_USERS%
Environment=DOMAIN=%SYNCSTORAGE_DOMAIN%

AutoUpdate=registry

[Service]
Type=oneshot
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target default.target