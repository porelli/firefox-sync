[Unit]
Description=Firefox Sync - Tokenserver Database Initialization
After=firefox-sync-network.service firefox-sync-tokenserver-db.service firefox-sync-syncstorage-migrate.service
Requires=firefox-sync-tokenserver-db.service firefox-sync-syncstorage-migrate.service

[Container]
Image=%IMAGE_REPOSITORY%:%SYNC_INIT_IMAGE%-%SYNC_INIT_IMAGE_TAG%
ContainerName=firefox-sync-tokenserver-db-init
Network=firefox-sync-network.network

# the setup migrations recorded (how containers) with the stack's database containers only
Environment=SYNC_DB_CONTAINERS=%SYNC_DB_CONTAINERS%
Environment=MARIADB_SERVER=%SYNC_TOKENSERVER_DB_HOST%
Environment=MARIADB_SERVER_PORT=%SYNC_TOKENSERVER_DB_PORT%
# false with your own MySQL server: its certificate is self-signed
Environment=MARIADB_TLS_VERIFY=%SYNC_DB_TLS_VERIFY%
Environment=MARIADB_DATABASE=%SYNC_TOKENSERVER_DB_NAME%
Environment=MARIADB_USER=%SYNC_TOKENSERVER_DB_USER%
Environment=MARIADB_PASSWORD=%SYNC_TOKENSERVER_DB_PASSWORD%
Environment=MAX_USERS=%SYNC_MAX_USERS%
# invite-only Sync (docs/limits.md#sync_allowed_accounts): empty is off
Environment="SYNC_ALLOWED_ACCOUNTS=%SYNC_ALLOWED_ACCOUNTS%"
Environment=DOMAIN=%SYNC_PUBLIC_URL%

AutoUpdate=registry

[Service]
Type=oneshot
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target default.target