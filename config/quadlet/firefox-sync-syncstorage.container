[Unit]
Description=Firefox Sync - Syncstorage Service
After=firefox-sync-network.service firefox-sync-tokenserver-db-init.service firefox-sync-admin.service
Requires=firefox-sync-tokenserver-db-init.service
# the admin UI first, when installed: the metrics go to it only if it runs at start
Wants=firefox-sync-admin.service

[Container]
Image=%IMAGE_REPOSITORY%:%SYNC_IMAGE%-%SYNC_IMAGE_TAG%
# no raw sockets, as compose's cap_drop: [NET_RAW]
DropCapability=NET_RAW
ContainerName=firefox-sync-syncstorage
Network=firefox-sync-network.network
PublishPort=%SYNC_EXPORT_PORT%:8000

Environment=SYNC_HOST=0.0.0.0
Environment=SYNC_HUMAN_LOGS=1
Environment=SYNC_MASTER_SECRET=%SYNC_MASTER_SECRET%
Environment=SYNC_SYNCSTORAGE__DATABASE_URL=mysql://%SYNC_STORAGE_DB_USER%:%SYNC_STORAGE_DB_PASSWORD%@%SYNC_STORAGE_DB_HOST%:%SYNC_STORAGE_DB_PORT%/%SYNC_STORAGE_DB_NAME%
Environment=SYNC_TOKENSERVER__ENABLED=true
Environment=SYNC_TOKENSERVER__RUN_MIGRATIONS=true
Environment=SYNC_TOKENSERVER__NODE_TYPE=mysql
Environment=SYNC_TOKENSERVER__DATABASE_URL=mysql://%SYNC_TOKENSERVER_DB_USER%:%SYNC_TOKENSERVER_DB_PASSWORD%@%SYNC_TOKENSERVER_DB_HOST%:%SYNC_TOKENSERVER_DB_PORT%/%SYNC_TOKENSERVER_DB_NAME%
Environment=SYNC_TOKENSERVER__INIT_NODE_URL=%SYNC_PUBLIC_URL%
Environment=SYNC_TOKENSERVER__FXA_EMAIL_DOMAIN=%FXA_EMAIL_DOMAIN%
Environment=SYNC_TOKENSERVER__FXA_OAUTH_SERVER_URL=%FXA_OAUTH_SERVER_URL%
Environment=SYNC_TOKENSERVER__FXA_METRICS_HASH_SECRET=%SYNC_METRICS_HASH_SECRET%
Environment=SYNC_TOKENSERVER__ADDITIONAL_BLOCKING_THREADS_FOR_FXA_REQUESTS=2
Environment=RUST_LOG=info

# metrics for the admin UI, when it runs: syncstorage-rs does not start if the metrics
# host does not resolve, so only point it there if it does
PodmanArgs=--entrypoint=/bin/sh
Exec=-c 'if getent hosts ffs-admin > /dev/null; then export SYNC_STATSD_HOST=ffs-admin SYNC_STATSD_PORT=8125; echo "Sending metrics to the admin UI"; fi; exec /app/bin/syncserver'
HealthCmd=curl -f http://localhost:8000/__heartbeat__
HealthInterval=30s
HealthTimeout=10s
HealthRetries=5

AutoUpdate=registry

[Service]
Restart=always

[Install]
WantedBy=multi-user.target default.target