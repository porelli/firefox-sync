[Unit]
Description=Firefox Sync - Mozilla accounts - Sign-up policy
After=firefox-sync-network.service firefox-sync-fxa-migrations.service
Requires=firefox-sync-fxa-migrations.service

[Container]
# ADMIN_IMAGE of .env, else IMAGE_REPOSITORY:admin-latest (as compose)
Image=%ADMIN_IMAGE%
ContainerName=firefox-sync-fxa-policy
Network=firefox-sync-network.network
# the setup migrations recorded (how containers) with fxa-db only
Environment="FXA_DB_CONTAINERS=%FXA_DB_CONTAINERS%"
Environment="FXA_DB_HOST=%FXA_MYSQL_HOST%"
Environment="FXA_DB_PORT=%FXA_MYSQL_PORT%"
# installs the policy and grants ffs_admin: FXA_MYSQL_POLICY_USER, empty: FXA_MYSQL_USER (and its password)
Environment="FXA_DB_ROOT_USER=%FXA_MYSQL_POLICY_USER%"
Environment="FXA_DB_ROOT_PASSWORD=%FXA_MYSQL_POLICY_PASSWORD%"
Environment="FXA_MYSQL_USER=%FXA_MYSQL_USER%"
Environment="FXA_MYSQL_PASSWORD=%FXA_MYSQL_PASSWORD%"
Environment="FXA_ADMIN_DB_PASSWORD=%FXA_ADMIN_DB_PASSWORD%"
Environment="FXA_SIGNUPS=%FXA_SIGNUPS%"
Environment="FXA_SIGNUP_ALLOWLIST=%FXA_SIGNUP_ALLOWLIST%"
# the most accounts (empty: initial:unlimited), see docs/limits.md#fxa_max_accounts
Environment="FXA_MAX_ACCOUNTS=%FXA_MAX_ACCOUNTS%"
Exec=fxa-init

AutoUpdate=registry

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target default.target
