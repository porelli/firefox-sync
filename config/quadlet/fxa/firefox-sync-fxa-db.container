[Unit]
Description=Firefox Sync - Mozilla accounts - Database
After=firefox-sync-network.service

[Container]
# FXA_MYSQL_IMAGE of .env (prepare_environment.sh: mysql:lts, or mysql:8 for the installs from
# before and for accounts images without mozilla/fxa#21709, with FXA_MYSQL_ARGS: see
# compose/fxa-mysql.yml)
Image=%FXA_MYSQL_IMAGE%
ContainerName=firefox-sync-fxa-db
Network=firefox-sync-network.network
PodmanArgs=--network-alias=fxa-db
Environment="MYSQL_ROOT_PASSWORD=%FXA_MYSQL_PASSWORD%"
Volume=firefox-sync-fxa-db.volume:/var/lib/mysql
# (the password in mysqladmin's environment, not in its arguments, which ps shows)
HealthCmd=MYSQL_PWD=$${MYSQL_ROOT_PASSWORD} mysqladmin ping -h 127.0.0.1 --protocol=tcp -uroot --silent
HealthInterval=10s
HealthTimeout=5s
HealthRetries=10
HealthStartPeriod=30s
Exec=mysqld --event-scheduler=ON %FXA_MYSQL_ARGS%

AutoUpdate=registry

[Service]
Restart=always
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target default.target
