[Unit]
Description=Firefox Sync - Mozilla accounts - Database migrations
After=firefox-sync-network.service firefox-sync-fxa-db.service firefox-sync-fxa-db-bootstrap.service
Requires=firefox-sync-fxa-db.service firefox-sync-fxa-db-bootstrap.service

[Container]
Image=%FXA_IMAGE%:%FXA_VERSION%
ContainerName=firefox-sync-fxa-migrations
Network=firefox-sync-network.network
PodmanArgs=--network-alias=fxa-migrations
# Mozilla publishes amd64 images only (emulated elsewhere), see docs/reference/images.md#accounts for arm64 images
# --arch only for another architecture than this host's (Mozilla's amd64 image, emulated): with it
# podman 4 pulls the tag from the registry at every start, over the local image
PodmanArgs=%FXA_ARCH_ARGS%
Environment="AUTH_MYSQL_HOST=%FXA_MYSQL_HOST%"
Environment="AUTH_MYSQL_PORT=%FXA_MYSQL_PORT%"
Environment="AUTH_MYSQL_USERNAME=%FXA_MYSQL_USER%"
Environment="AUTH_MYSQL_PASSWORD=%FXA_MYSQL_PASSWORD%"
Environment="OAUTH_MYSQL_HOST=%FXA_MYSQL_HOST%"
Environment="OAUTH_MYSQL_PORT=%FXA_MYSQL_PORT%"
Environment="OAUTH_MYSQL_USERNAME=%FXA_MYSQL_USER%"
Environment="OAUTH_MYSQL_PASSWORD=%FXA_MYSQL_PASSWORD%"
Environment="PROFILE_MYSQL_HOST=%FXA_MYSQL_HOST%"
Environment="PROFILE_MYSQL_PORT=%FXA_MYSQL_PORT%"
Environment="PROFILE_MYSQL_USERNAME=%FXA_MYSQL_USER%"
Environment="PROFILE_MYSQL_PASSWORD=%FXA_MYSQL_PASSWORD%"
Environment="PUSHBOX_MYSQL_HOST=%FXA_MYSQL_HOST%"
Environment="PUSHBOX_MYSQL_PORT=%FXA_MYSQL_PORT%"
Environment="PUSHBOX_MYSQL_USERNAME=%FXA_MYSQL_USER%"
Environment="PUSHBOX_MYSQL_PASSWORD=%FXA_MYSQL_PASSWORD%"
Exec=sh -c 'cd /fxa/packages/db-migrations && for i in $$(seq 1 60); do node bin/patcher.mjs && exit 0; sleep 5; done; exit 1'

AutoUpdate=registry

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target default.target
