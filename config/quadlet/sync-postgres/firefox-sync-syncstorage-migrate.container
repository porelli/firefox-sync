# Installed instead of ../firefox-sync-syncstorage-migrate.container with the Sync server on
# PostgreSQL: as the Sync server's own role (SYNC_POSTGRES_APP_USER, firefox-sync-sync-role-init), like the Sync server
[Unit]
Description=Firefox Sync - Syncstorage Database Migrations
After=firefox-sync-network.service firefox-sync-postgres-db.service firefox-sync-sync-role-init.service firefox-sync-db-bootstrap.service
Requires=firefox-sync-postgres-db.service firefox-sync-sync-role-init.service firefox-sync-db-bootstrap.service

[Container]
# Runs the database migrations (and creates the sync node) without exposing
# the service, so that SYNC_MAX_USERS is enforced before anybody can reach it
# (syncstorage-rs is killed 30 s after SIGTERM: its graceful shutdown can hang for good)
Image=%IMAGE_REPOSITORY%:%SYNC_IMAGE%-%SYNC_IMAGE_TAG%
# no raw sockets, as compose's cap_drop: [NET_RAW]
DropCapability=NET_RAW
ContainerName=firefox-sync-syncstorage-migrate
Network=firefox-sync-network.network

Environment=SYNC_HOST=0.0.0.0
Environment=SYNC_HUMAN_LOGS=1
Environment=SYNC_MASTER_SECRET=%SYNC_MASTER_SECRET%
Environment=SYNC_SYNCSTORAGE__DATABASE_URL=postgres://%SYNC_POSTGRES_CONNECT_USER%:%SYNC_POSTGRES_CONNECT_PASSWORD%@%SYNC_POSTGRES_HOST%:%SYNC_POSTGRES_PORT%/%SYNC_POSTGRES_NAME%
Environment=SYNC_TOKENSERVER__ENABLED=true
Environment=SYNC_TOKENSERVER__RUN_MIGRATIONS=true
Environment=SYNC_TOKENSERVER__NODE_TYPE=postgres
Environment=SYNC_TOKENSERVER__DATABASE_URL=postgres://%SYNC_POSTGRES_CONNECT_USER%:%SYNC_POSTGRES_CONNECT_PASSWORD%@%SYNC_POSTGRES_HOST%:%SYNC_POSTGRES_PORT%/%SYNC_POSTGRES_NAME%
Environment=SYNC_TOKENSERVER__INIT_NODE_URL=%SYNC_PUBLIC_URL%
Environment=SYNC_TOKENSERVER__FXA_EMAIL_DOMAIN=%FXA_EMAIL_DOMAIN%
Environment=SYNC_TOKENSERVER__FXA_OAUTH_SERVER_URL=%FXA_OAUTH_SERVER_URL%
Environment=SYNC_TOKENSERVER__FXA_METRICS_HASH_SECRET=%SYNC_METRICS_HASH_SECRET%
Environment=SYNC_TOKENSERVER__ADDITIONAL_BLOCKING_THREADS_FOR_FXA_REQUESTS=2
Environment=RUST_LOG=info

PodmanArgs=--entrypoint=/bin/sh
Exec=-c 'pid=; for i in $$(seq 1 120); do if [ -z "$$pid" ] || ! kill -0 $$pid 2>/dev/null; then /app/bin/syncserver & pid=$$!; fi; if curl -sf http://localhost:8000/__heartbeat__ >/dev/null; then kill $$pid; (sleep 30; kill -0 $$pid 2>/dev/null && echo syncstorage-rs still running 30 s after SIGTERM, killed && kill -9 $$pid) & wait $$pid; kill $$! 2>/dev/null; echo Migrations completed; exit 0; fi; sleep 1; done; echo Timeout waiting for syncstorage-rs to start; kill $$pid; exit 1'

AutoUpdate=registry

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target default.target
