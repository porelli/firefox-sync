# Installed instead of ../firefox-sync-tokenserver-db-init.container with the Sync server on
# PostgreSQL: SYNC_MAX_USERS, the grants of the Sync server's role, and the admin UI's roles and
# database (created here in the PostgreSQL container, by database-setup.sql on your own server)
[Unit]
Description=Firefox Sync - Tokenserver Database Initialization
After=firefox-sync-network.service firefox-sync-postgres-db.service firefox-sync-syncstorage-migrate.service
Requires=firefox-sync-postgres-db.service firefox-sync-syncstorage-migrate.service

[Container]
Image=%IMAGE_REPOSITORY%:%SYNC_INIT_IMAGE%-%SYNC_INIT_IMAGE_TAG%
ContainerName=firefox-sync-tokenserver-db-init
Network=firefox-sync-network.network

# the setup migrations recorded (how containers) with the stack's database containers only
Environment=SYNC_DB_CONTAINERS=%SYNC_DB_CONTAINERS%
Environment=POSTGRES_SERVER=%SYNC_POSTGRES_HOST%
Environment=POSTGRES_SERVER_PORT=%SYNC_POSTGRES_PORT%
Environment=POSTGRES_DATABASE=%SYNC_POSTGRES_NAME%
Environment=POSTGRES_USER=%SYNC_POSTGRES_USER%
Environment=POSTGRES_PASSWORD=%SYNC_POSTGRES_PASSWORD%
Environment=MAX_USERS=%SYNC_MAX_USERS%
Environment=DOMAIN=%SYNC_PUBLIC_URL%
Environment=POSTGRES_SYNC_USER=%SYNC_POSTGRES_APP_USER%
Environment=POSTGRES_SYNC_PASSWORD=%SYNC_POSTGRES_APP_PASSWORD%
Environment=ADMIN_DB_USER=%ADMIN_DB_USER%
Environment=ADMIN_DB_SYNC_USER=%ADMIN_DB_SYNC_USER%
Environment=ADMIN_DB_PASSWORD=%ADMIN_DB_PASSWORD%
Environment=ADMIN_DB_NAME=%ADMIN_DB_NAME%

AutoUpdate=registry

[Service]
Type=oneshot
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target default.target
