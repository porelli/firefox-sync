# Installed instead of ../firefox-sync-tokenserver-db.container with SYNC_DB=mysql (docs/databases.md#mysql-instead-of-mariadb).
[Unit]
Description=Firefox Sync - Tokenserver Database (MySQL)
After=firefox-sync-network.service

[Container]
# SYNC_MYSQL_IMAGE of .env (prepare_environment.sh: mysql:lts, mysql:8 for the installs from before)
Image=%SYNC_MYSQL_IMAGE%
ContainerName=firefox-sync-tokenserver-db
Network=firefox-sync-network.network
# MySQL must not open MariaDB's data files: its own volume
Volume=firefox-sync-tokenserver-db-mysql.volume:/var/lib/mysql
Volume=%SCRIPT_DIR%/db/mysql/admin-user.sh:/ffs-db/admin-user.sh:ro,z

Environment=MYSQL_RANDOM_ROOT_PASSWORD=yes
Environment=MYSQL_DATABASE=%SYNC_TOKENSERVER_DB_NAME%
Environment=MYSQL_USER=%SYNC_TOKENSERVER_DB_USER%
Environment=MYSQL_PASSWORD=%SYNC_TOKENSERVER_DB_PASSWORD%

# the admin UI's users, created by db/mysql/admin-user.sh: ADMIN_DB_USER for its
# own database (the event log, the audit trail...), ADMIN_DB_SYNC_USER with SELECT
# and EXECUTE here
Environment=ADMIN_DB_ROLE=tokenserver
Environment=ADMIN_DB_USER=%ADMIN_DB_USER%
Environment=ADMIN_DB_SYNC_USER=%ADMIN_DB_SYNC_USER%
Environment=ADMIN_DB_PASSWORD=%ADMIN_DB_PASSWORD%
Environment=ADMIN_DB_NAME=%ADMIN_DB_NAME%

# no binary logging, like MariaDB: no replica reads it, it would keep 30 days of every
# change, and the init container's max users trigger would need log_bin_trust_function_creators
Exec=sh /ffs-db/admin-user.sh mysqld --disable-log-bin --myisam-recover-options=BACKUP,FORCE

# over TCP: during the first start the image runs a temporary server on the socket only;
# the password in mysqladmin's environment, not in its arguments, which ps shows
HealthCmd=MYSQL_PWD=$${MYSQL_PASSWORD} mysqladmin ping -h 127.0.0.1 --protocol=tcp -u%SYNC_TOKENSERVER_DB_USER% --silent
HealthInterval=10s
HealthTimeout=5s
HealthRetries=10
HealthStartPeriod=30s

AutoUpdate=registry

[Service]
Restart=always
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target default.target
