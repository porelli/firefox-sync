# Nothing leaves the stack: every telemetry, metrics and error-reporting path of the
# self-hosted Mozilla accounts, off. Mozilla's defaults already send little from here, these
# settings make it explicit so that a changed default of a new release cannot turn one on.
# See docs/accounts.md#telemetry.
#
# The one place of these values: compose (compose/fxa.yml, env_file of every accounts
# service), the Quadlets (EnvironmentFile= of config/quadlet/fxa/*.container) and the Helm
# chart (charts/firefox-sync/files/fxa/no-telemetry.env, a byte-identical copy that
# tests/helm_parity.py checks) all read this file. Every accounts service gets all of them,
# each reads its own. KEY=VALUE lines only, no quotes: compose, podman and the chart read
# them alike.

# Sentry error reports (auth, content and its pages, profile, profile worker and static):
# empty is none
SENTRY_DSN=

# Glean in the accounts pages (the browser): off, no upload. The pages turn it on by
# themselves all the same (signed out always, signed in with the account's "Allow Mozilla
# accounts to send technical and interaction data" on), and send to GLEAN_SERVER_ENDPOINT,
# incoming.telemetry.mozilla.org when it is empty: so that is set per deployment, to the
# stack's own accounts pages (FXA_CONTENT_URL, which answer 404 and keep nothing), in the
# content server's environment (compose/fxa.yml, its Quadlet, the chart's fxa-content.yaml)
GLEAN_ENABLED=false
GLEAN_UPLOAD_ENABLED=false
# server-side Glean events of the content and auth servers: JSON lines in their logs, which
# Mozilla's own deployment ships to its telemetry (here they would only fill the logs)
CONTENT_SERVER_GLEAN_ENABLED=false
AUTH_GLEAN_ENABLED=false

# Amplitude events, as the server-side Glean ones (JSON lines in the logs, which Mozilla ships
# to Amplitude): the auth server's AMPLITUDE_ENABLED, the content server's AMPLITUDE_DISABLED
AMPLITUDE_ENABLED=false
AMPLITUDE_DISABLED=true
# the content server's flow events (the pages' metrics, written to its log)
FLOW_METRICS_DISABLED=true

# StatsD: the auth server's (STATSD_ENABLE, to DD_AGENT_HOST), the content server's
# (METRIC_ENABLED, to METRIC_HOST), the pairing server's (PAIR_STATSD_HOST, localhost:8125 by
# default; empty is none)
STATSD_ENABLE=false
METRIC_ENABLED=false
PAIR_STATSD_HOST=

# OpenTelemetry traces (auth and profile servers): to Google Cloud Trace or an OTLP collector
TRACING_GCP_EXPORTER_ENABLED=false
TRACING_OTEL_EXPORTER_ENABLED=false
TRACING_SAMPLE_RATE=0

# Nimbus experiments of the content server (asks Mozilla's Cirrus service, NIMBUS_CIRRUS_HOST)
NIMBUS_ENABLED=false
# the pairing server's IP reputation service (empty: none)
PAIR_IP_REPUTATION_SERVER=
