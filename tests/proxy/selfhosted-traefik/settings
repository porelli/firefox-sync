# the self-hosted accounts, the pairing server, the admin UI with another OpenID Connect
# provider open to anybody, your Traefik's Docker provider: two entry points, a resolver
deploy=compose
SYNC_PUBLIC_URL=https://sync.example.com
COMPOSE_PROFILES=admin,pairing
COMPOSE_PROJECT_NAME=ffs
FXA_MYSQL_PASSWORD=not-a-placeholder
FXA_CONTENT_URL=https://accounts.example.com
FXA_AUTH_URL=https://api.example.com
FXA_PROFILE_URL=https://profile.example.com
FXA_PAIRING_URL=wss://pairing.example.com
ADMIN_OIDC_REDIRECT_URL=https://admin.example.com/auth/callback
PROXY_ADMIN_ALLOW=
PROXY=traefik
TRAEFIK_NETWORK=web-proxy
TRAEFIK_ENTRYPOINTS=https,https6
TRAEFIK_HTTP_ENTRYPOINT=http
TRAEFIK_CERTRESOLVER=le
