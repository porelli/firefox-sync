# The Sync server's settings have the SYNC_ prefix (docs/upgrading.md#renamed-settings): an .env
# with the old names (MARIADB_TOKENSERVER_*, MAX_USERS, SYNCSTORAGE_DOMAIN...) still works for now,
# ./prepare_environment.sh --upgrade renames them
SYNC_TOKENSERVER_DB_PASSWORD=<REPLACE_WITH_SOMETHING_SECURE>
SYNC_STORAGE_DB_PASSWORD=<REPLACE_WITH_SOMETHING_SECURE>
SYNC_POSTGRES_PASSWORD=<REPLACE_WITH_SOMETHING_SECURE>
# the Sync server's own role in the stack's PostgreSQL container, which is no superuser
# (SYNC_POSTGRES_USER is the container's superuser, the image makes it one: the migrations, the
# init container and the backups use it). prepare_environment.sh sets both, letters and
# digits. Empty (an install from before them, or your own server, where SYNC_POSTGRES_USER is no
# superuser): the Sync server connects as SYNC_POSTGRES_USER, and reaches the admin UI's database
SYNC_POSTGRES_APP_USER=
SYNC_POSTGRES_APP_PASSWORD=
SYNC_MASTER_SECRET=<REPLACE_WITH_SOMETHING_SECURE>
SYNC_METRICS_HASH_SECRET=<REPLACE_WITH_SOMETHING_SECURE>
SYNC_PUBLIC_URL=https://<REPLACE_WITH_YOUR_DOMAIN>
# where the Sync server listens for your reverse proxy, [address:]port: 127.0.0.1:5000 on this
# host only (as the other ports below); 0.0.0.0:5000, or 5000 alone, on every interface
SYNC_EXPORT_PORT=127.0.0.1:5000
# accounts that can use this server: a number (0: no new account), or unlimited (no limit).
# N (or fixed:N): set on every start, read-only in the admin UI. initial:N: set on the
# first start only, then managed in the admin UI (e.g. initial:5, initial:unlimited)
SYNC_MAX_USERS=1

# OPTIONAL ADMIN UI (see docs/admin/README.md): max users, and with self-hosted accounts sign-ups and accounts
# Optional services, comma-separated: admin, backup (nightly backups, see docs/backups.md#the-backup-service),
# and pairing with the self-hosted accounts
# COMPOSE_PROFILES=admin
ADMIN_PASSWORD=<REPLACE_WITH_SOMETHING_SECURE>
ADMIN_EXPORT_PORT=127.0.0.1:8090
# the password of the admin UI's own database users (ADMIN_DB_USER and ADMIN_DB_SYNC_USER
# below): the first alone reaches its database (the event log, the audit trail, notes,
# metrics, backup runs), the Sync server's users cannot read or change it. Random letters
# and digits, prepare_environment.sh generates it (./prepare_environment.sh --upgrade for an
# existing .env). Empty (an install from before it): they stay in the tokenserver database,
# within the Sync server's reach, the setup checks fail (docs/upgrading.md#the-admin-uis-own-database)
ADMIN_DB_PASSWORD=
# email alerts (refused sign-ups, components down, new releases, admin sign-ins, with
# self-hosted accounts new accounts and devices), sent with the FXA_SMTP_* server below
# (fill it in for email alerts and invitations, also without self-hosted accounts)
ADMIN_ALERT_EMAIL=
# 1, true or yes: the admin UI sends FXA_SMTP_PASS also to an SMTP server that offers no TLS (in
# clear: a relay on this host or a network you trust only); empty: it refuses to
ADMIN_SMTP_INSECURE_AUTH=
# the same alerts, also or instead of email (no SMTP server needed for them), to other
# destinations: their URLs, separated by commas, in single quotes. The URLs hold tokens:
# keep .env private (the admin UI shows and logs only scheme://host). See docs/admin/alerts.md:
#   slack://hooks.slack.com/services/T000/B000/XXXX   the webhook URL, https:// -> slack://
#   discord://discord.com/api/webhooks/<id>/<token>   the webhook URL, https:// -> discord://
#   teams://<the URL of the Teams workflow, without https://>
#   ntfy://ntfy.sh/<topic>, ntfy://<access token>@ntfy.example.com/<topic>
#   gotify://gotify.example.com/<application token>
#   telegram://<bot token>/<chat id>
#   matrix://<access token>@matrix.example.org/<room id, !...:example.org, or #alias:example.org>
#   webhook://n8n.example.com/webhook/<id>?@Authorization=Bearer%20<token>   JSON, any service
# +http after the scheme (ntfy+http://, webhook+http://...) for a server on your network without https
# e.g. ADMIN_NOTIFY='ntfy://ntfy.sh/my-secret-topic,slack://hooks.slack.com/services/T000/B000/XXXX'
ADMIN_NOTIFY=
# Prometheus metrics at /metrics of the admin UI with this bearer token (empty: off)
ADMIN_METRICS_TOKEN=
# compare the running versions with the newest releases on GitHub (false: never ask)
ADMIN_UPDATE_CHECK=true
# every hour check from the server the public https URLs (Sync, and the accounts), their
# certificates and the sign-up gate behind your reverse proxy (false: never)
ADMIN_PUBLIC_CHECK=true
# accounts not synced for this many days are marked inactive
ADMIN_STALE_DAYS=90
# days of metrics and events kept
ADMIN_RETENTION_DAYS=30
# days the events of the admins (who did what, on which account) are kept
ADMIN_AUDIT_RETENTION_DAYS=365
# 1: every day delete the Sync data nobody reads any more (expired items, replaced keys,
# deleted accounts), see docs/admin/storage.md; empty: only with "Purge now" on the overview
ADMIN_PURGE=
# self-hosted accounts: every day delete the accounts that never confirmed their email
# after this many days (at least 1; empty: never)
ADMIN_DELETE_UNCONFIRMED_DAYS=
# self-hosted accounts: an account that has not confirmed its email this many hours after
# its sign-up is marked unconfirmed in the accounts list (empty: 72)
ADMIN_UNCONFIRMED_HOURS=
# self-hosted accounts: an alert when more accounts than this are created in an hour (0: never)
ADMIN_SIGNUP_BURST=10
# an alert on a spike of Sync errors: this share (%) of the requests in 15 minutes, with at
# least ADMIN_ERROR_RATE_MIN_ERRORS errors and 3 times the share of the day before (0: never)
ADMIN_ERROR_RATE_PERCENT=10
ADMIN_ERROR_RATE_MIN_ERRORS=20
# an alert when a database grows more than this many MB in a day (0: never), or more than
# this many times its usual daily growth, from 100 MB and 3 days of history (0: never)
ADMIN_DB_GROWTH_MB=1024
ADMIN_DB_GROWTH_FACTOR=5
# time zone of the pages and the alerts, e.g. Europe/Rome (empty: UTC)
ADMIN_TZ=
# BACKUPS (COMPOSE_PROFILES=backup, or firefox-sync-backup.timer with Quadlets, see docs/backups.md#the-backup-service):
# every day at this time (UTC), the newest copies kept in the backups volume
BACKUP_TIME=03:00
BACKUP_KEEP=7
# SIGNING IN TO THE ADMIN UI (see docs/admin/signing-in.md), any of:
# - the password above (empty: no password sign-in)
# - OpenID Connect (Authentik, Keycloak, Google, Entra, Dex, the self-hosted accounts...):
#   issuer URL, client id and secret (empty secret: public client), the exact public
#   callback URL (https://<admin host>/auth/callback), scopes (default "openid email profile"),
#   the button label (default "single sign-on") and the claim with the groups (default "groups")
ADMIN_OIDC_ISSUER=
ADMIN_OIDC_CLIENT_ID=
ADMIN_OIDC_CLIENT_SECRET=
ADMIN_OIDC_REDIRECT_URL=
ADMIN_OIDC_SCOPES=
ADMIN_OIDC_NAME=
ADMIN_OIDC_GROUPS_CLAIM=
# true: accept emails without email_verified=true (risky: anybody who can set that email
# at the provider signs in), needed with the self-hosted accounts, see docs/admin/signing-in.md#self-hosted-accounts
ADMIN_OIDC_TRUST_UNVERIFIED_EMAIL=
# - a header set by a forward-auth proxy (Authelia, Authentik, oauth2-proxy, Tailscale...):
#   the header with the email (e.g. Remote-Email), optional header with comma-separated
#   groups, and the CIDRs of the proxy as the admin UI sees it (required, others are ignored)
ADMIN_AUTH_HEADER=
ADMIN_AUTH_GROUPS_HEADER=
ADMIN_TRUSTED_PROXIES=
# with OpenID Connect or the header, who is an admin (at least one is required): emails
# and @domains, comma-separated, and/or group names
ADMIN_ALLOWED_USERS=
ADMIN_ALLOWED_GROUPS=
# 1, true or yes: the session cookie also over plain HTTP, other than http://localhost (anybody on
# the way can take it: only on a network you trust), needed for an http:// ADMIN_OIDC_REDIRECT_URL
ADMIN_INSECURE_COOKIE=

# DATABASE BACKEND: MariaDB (default), MySQL or PostgreSQL
# the Sync database containers (syncstorage-rs-mysql images): mariadb (MariaDB lts, default) or mysql
# (MySQL; with docker compose compose/sync-mysql.yml in COMPOSE_FILE below). Choose before the first
# start: each has its own volumes, switching starts with empty databases (docs/databases.md#mysql-instead-of-mariadb)
SYNC_DB=mariadb
# The database images below follow a tag: mariadb:lts and mysql:lts are always the newest
# long-term major, so when MariaDB or MySQL releases the next one, the next pull (docker compose
# pull, or the Quadlets' AutoUpdate=registry on its own) brings it, and the server upgrades the
# data at its next start, with no way back but a backup. To choose when, pin a major instead
# (mariadb:12, mysql:9) and move it yourself, a backup first. Not set at all, the containers
# refuse to start on data of another major (db/mysql/keep-major.sh) rather than upgrade it.
# with SYNC_DB=mariadb, the image of the Sync database containers and of the backups; unset:
# mariadb:lts, which prepare_environment.sh also writes for new installs (--upgrade and a re-run:
# the major the data of an install from before holds)
# SYNC_MARIADB_IMAGE=mariadb:lts
# with SYNC_DB=mysql, the same; unset: mysql:lts (MySQL 9 today), for new installs too. The
# installs from before run 8: prepare_environment.sh --upgrade writes mysql:8 for them
# (docs/upgrading.md#mysql-8-to-9)
# SYNC_MYSQL_IMAGE=mysql:lts
# docker compose: the compose files, compose/sync.yml and the Sync database's (sync-mariadb.yml,
# sync-mysql.yml or sync-postgres.yml, with the syncstorage-rs-postgres images below), with
# self-hosted accounts compose/fxa.yml and fxa-mysql.yml or fxa-mariadb.yml; and the project, which
# names the containers and the volumes. prepare_environment.sh writes both (docs/install/compose.md#the-compose-files)
# COMPOSE_FILE=compose/sync.yml:compose/sync-mariadb.yml
# COMPOSE_PROJECT_NAME=firefox-sync

# EDIT ONLY IF YOU NEED TO PIN THE IMAGES TO A DIFFERENT SOURCE OR TAG
IMAGE_REPOSITORY=ghcr.io/porelli/firefox-sync
SYNC_IMAGE=syncstorage-rs-mysql
SYNC_IMAGE_TAG=latest
SYNC_INIT_IMAGE=syncstorage-rs-mysql-init
SYNC_INIT_IMAGE_TAG=latest
# the admin UI's image (also fxa-policy's); unset: <IMAGE_REPOSITORY>:admin-latest
# ADMIN_IMAGE=ghcr.io/porelli/firefox-sync:admin-latest

# EDIT ONLY IF YOU ARE SELF HOSTING ALSO FIREFOX ACCOUNTS
FXA_EMAIL_DOMAIN=api.accounts.firefox.com
FXA_OAUTH_SERVER_URL=https://oauth.accounts.firefox.com/v1

# EDIT ONLY IF YOU ARE HOSTING YOUR DATABASE OUTSIDE THIS STACK
# Create the databases and users first with db/mysql/*.sql or db/postgres/sync.sql, see docs/databases.md#create-the-databases-and-users
# (prepare_environment.sh does all of this when asked). Passwords: A-Z a-z 0-9 . _ ~ - only
# 1: start the database containers of this stack; 0: use your own server
SYNC_DB_CONTAINERS=1
# false with your own server: the init container's client checks the certificate, MySQL's is self-signed
SYNC_DB_TLS_VERIFY=true
# your own server: an account that can create users, with which the stack applies database-setup.sql
# itself at every start (docs/databases.md#let-the-stack-apply-them); empty: it only checks that
# the users, grants and databases are there, you run database-setup.sql again after an upgrade
SYNC_DB_BOOTSTRAP_USER=
SYNC_DB_BOOTSTRAP_PASSWORD=
SYNC_TOKENSERVER_DB_HOST=tokenserver_db
SYNC_TOKENSERVER_DB_PORT=3306
SYNC_TOKENSERVER_DB_NAME=tokenserver
SYNC_TOKENSERVER_DB_USER=tokenserver
SYNC_STORAGE_DB_HOST=syncstorage_db
SYNC_STORAGE_DB_PORT=3306
SYNC_STORAGE_DB_NAME=syncstorage
SYNC_STORAGE_DB_USER=syncstorage
SYNC_POSTGRES_HOST=postgres_db
SYNC_POSTGRES_PORT=5432
SYNC_POSTGRES_NAME=syncserver
SYNC_POSTGRES_USER=syncserver
# postgres_db and backup: pins the PostgreSQL major of each install; unset: postgres:latest.
# prepare_environment.sh writes the major postgres:latest is at when it runs (postgres:<major>;
# --upgrade: postgres:18 for the installs from before it). Moving to a newer major needs a dump
# and restore or pg_upgrade (docs/upgrading.md#postgresql): the
# official image refuses to start on an older major's data
# SYNC_POSTGRES_IMAGE=postgres:latest
# the admin UI's own database on the tokenserver's server (PostgreSQL: the same server), its
# user (that database only), and the user that reads the Sync data (also on the storage
# server; nothing on the admin UI's database), both with ADMIN_DB_PASSWORD (docs/reference/database-users.md#the-admin-uis-own-database)
ADMIN_DB_NAME=ffs_admin
ADMIN_DB_USER=ffs_admin_ui
ADMIN_DB_SYNC_USER=ffs_admin_sync

# SELF-HOSTED MOZILLA ACCOUNTS (only with compose/fxa.yml, see docs/accounts.md)
# Also set FXA_OAUTH_SERVER_URL=http://fxa-auth:9000/v1 and FXA_EMAIL_DOMAIN to the host of FXA_AUTH_URL above
# images built from Mozilla's releases for amd64 and arm64 and tested before publishing
# (fxa-mono-latest = newest tested release, pin with e.g. fxa-mono-v1.347.1; to upgrade see docs/upgrading.md#self-hosted-accounts);
# Mozilla's own image is amd64 only: FXA_IMAGE=docker.io/mozilla/fxa-mono, FXA_VERSION=v1.347.1
FXA_IMAGE=ghcr.io/porelli/firefox-sync
FXA_VERSION=fxa-mono-latest
# amd64 or arm64, set by prepare_environment.sh (amd64 with Mozilla's own images)
FXA_ARCH=amd64
FXA_CONTENT_URL=https://accounts.<REPLACE_WITH_YOUR_DOMAIN>
FXA_AUTH_URL=https://api.<REPLACE_WITH_YOUR_DOMAIN>
FXA_PROFILE_URL=https://profile.<REPLACE_WITH_YOUR_DOMAIN>
# the accounts database: mysql (MySQL, what Mozilla runs) or mariadb (MariaDB, tested here, see
# docs/accounts.md#mysql-or-mariadb; with docker compose compose/fxa-mariadb.yml in COMPOSE_FILE, not fxa-mysql.yml)
FXA_DB=mysql
# with FXA_DB=mysql, the image of fxa-db and of its backups; unset: mysql:lts, MySQL's newest
# long-term major (9 today), for accounts images with mozilla/fxa#21554 (ours, docs/accounts.md#mysql-or-mariadb).
# prepare_environment.sh writes it for new installs: mysql:lts, or mysql:8 with FXA_MYSQL_ARGS
# below for images without it (Mozilla's, ours from before); --upgrade: mysql:8 and FXA_MYSQL_ARGS
# for the installs from before (their users are on mysql_native_password, which MySQL 9 does not
# have: docs/upgrading.md#mysql-8-to-9). As mysql:lts moves to the next major (a pull, or the Quadlets'
# AutoUpdate=registry), MySQL upgrades the data at the next start: pin a major (e.g. mysql:9) to
# choose when (unset, fxa-db refuses to start on data of another major)
# FXA_MYSQL_IMAGE=mysql:lts
# extra options of fxa-db's mysqld, empty by default; mysql:8 for images without mozilla/fxa#21554
# (MySQL 9 refuses these options):
# FXA_MYSQL_ARGS=--mysql-native-password=ON --authentication-policy=mysql_native_password
# with FXA_DB=mariadb, the image of fxa-db and of its backups; unset: mariadb:lts, MariaDB's
# newest long-term major (12 today, with our accounts images, docs/accounts.md#mariadb-12), which prepare_environment.sh
# also writes for new installs. When lts moves to the next major, a pull (or the Quadlets'
# AutoUpdate=registry) upgrades the data at the next start, with no way back but a backup: pin a
# major (e.g. mariadb:12) to choose when.
# The installs from before it run 11: prepare_environment.sh --upgrade writes mariadb:11 for
# them (docs/upgrading.md#mariadb)
# FXA_MARIADB_IMAGE=mariadb:lts
# 1: it runs in this stack (fxa-db); 0: your own MySQL 8.4/9 or MariaDB 11.4+ server (docs/databases.md#your-own-server)
FXA_DB_CONTAINERS=1
FXA_MYSQL_HOST=fxa-db
FXA_MYSQL_PORT=3306
FXA_MYSQL_USER=root
FXA_MYSQL_PASSWORD=<REPLACE_WITH_SOMETHING_SECURE>
# installs the sign-up policy and grants the admin UI's user ffs_admin (empty: FXA_MYSQL_USER
# and FXA_MYSQL_PASSWORD, this password is then not used)
FXA_MYSQL_POLICY_USER=
FXA_MYSQL_POLICY_PASSWORD=
# your own server: the account that applies database-setup-fxa.sql at every start, as
# SYNC_DB_BOOTSTRAP_USER (docs/databases.md#let-the-stack-apply-them)
FXA_DB_BOOTSTRAP_USER=
FXA_DB_BOOTSTRAP_PASSWORD=
FXA_AUTH_SECRET=<REPLACE_WITH_SOMETHING_SECURE>
FXA_OAUTH_SECRET=<REPLACE_WITH_SOMETHING_SECURE>
FXA_PROFILE_SECRET=<REPLACE_WITH_SOMETHING_SECURE>
FXA_FLOW_ID_KEY=<REPLACE_WITH_SOMETHING_SECURE>
FXA_SESSION_TOKEN_HANDLE_KEY=<REPLACE_WITH_SOMETHING_SECURE>
FXA_CONTENT_SESSION_SECRET=<REPLACE_WITH_SOMETHING_SECURE>
FXA_SMTP_HOST=<REPLACE_WITH_YOUR_SMTP_SERVER>
FXA_SMTP_PORT=587
FXA_SMTP_USER=
FXA_SMTP_PASS=
FXA_SMTP_SECURE=false
FXA_SMTP_SENDER="Mozilla accounts <no-reply@<REPLACE_WITH_YOUR_DOMAIN>>"
# who can create an account: open, allowlist (only the emails and @domains of
# FXA_SIGNUP_ALLOWLIST, comma-separated) or closed. Applied when changed here, the
# admin UI changes them too. Existing accounts are not affected.
FXA_SIGNUPS=open
FXA_SIGNUP_ALLOWLIST=
# the most accounts that can be created, confirmed or not (0: nobody new): N or unlimited
# (or fixed:N) set on every start, read-only in the admin UI; initial:N set once, then
# managed in the admin UI. Empty: initial:unlimited
FXA_MAX_ACCOUNTS=initial:unlimited
# database password of the admin UI for the accounts
FXA_ADMIN_DB_PASSWORD=<REPLACE_WITH_SOMETHING_SECURE>
# reverse proxies in front of the accounts API + 1, for the client IP of the rate limits (see docs/reverse-proxy.md#client-ip-address)
FXA_CLIENT_ADDRESS_DEPTH=2
# lifetime of the access tokens of Firefox (Mozilla's default: "365 minutes"), see docs/admin/accounts.md#sign-out-and-disable
FXA_ACCESS_TOKEN_LIFETIME="60 minutes"
# true: record the security history of every account (sign-ins, password, 2-step and
# recovery key changes) with the IP address of each, shown in the account settings and the
# admin UI (with alerts); false (default): nothing recorded. The sign-in code is asked as
# before either way. See docs/accounts.md#security-history
FXA_ACCOUNT_EVENTS=false
# the log level of the accounts API (fxa-auth): ERROR, WARN, INFO (default), DEBUG, TRACE
# FXA_LOG_LEVEL=INFO
# optional QR code pairing server (instead of Mozilla's): add pairing to COMPOSE_PROFILES above and uncomment
# FXA_PAIRING_URL=wss://pairing.<REPLACE_WITH_YOUR_DOMAIN>
# built for amd64 and arm64 like the accounts (Mozilla's own: docker.io/mozilla/channelserver, amd64 only)
FXA_PAIRING_IMAGE=ghcr.io/porelli/firefox-sync:fxa-channelserver-latest
# the pairing server takes the client IP from X-Forwarded-For of these addresses only (your
# reverse proxy as the container sees it; docker compose only, the Quadlets have no pairing server)
# FXA_PAIRING_TRUSTED_PROXIES=127.0.0.1,172.16.0.0/12,10.0.0.0/8,192.168.0.0/16
# local ports for your reverse proxy
FXA_PAIRING_EXPORT_PORT=127.0.0.1:8058
FXA_CONTENT_EXPORT_PORT=127.0.0.1:3030
FXA_AUTH_EXPORT_PORT=127.0.0.1:9000
FXA_PROFILE_EXPORT_PORT=127.0.0.1:1111
FXA_PROFILE_STATIC_EXPORT_PORT=127.0.0.1:1112
# with the admin UI, the sign-up gate: POST /v1/account/create of FXA_AUTH_URL
ADMIN_GATE_EXPORT_PORT=127.0.0.1:8091
# sign in to the admin UI with these accounts: an OAuth client id (16 hex characters),
# registered at every start with ADMIN_OIDC_REDIRECT_URL; the admin UI then defaults
# ADMIN_OIDC_ISSUER to FXA_CONTENT_URL (with Quadlets set the ADMIN_OIDC_* above by hand,
# prepare_environment.sh does). Keep the secret empty: the accounts service refuses PKCE
# from clients with a secret (64 hex characters), and the admin UI always uses PKCE
ADMIN_FXA_CLIENT_ID=
ADMIN_FXA_CLIENT_SECRET=
