{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["syncDomain"],
  "properties": {
    "image": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string"
        },
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        },
        "syncstorageTag": {
          "type": "string"
        },
        "initTag": {
          "type": "string"
        },
        "adminTag": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "syncDomain": {
      "type": "string",
      "pattern": "^https?://",
      "minLength": 1
    },
    "maxUsers": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^(fixed:|initial:)?([0-9]+|unlimited)$"
        },
        {
          "type": "integer",
          "minimum": 0
        }
      ]
    },
    "smtp": {
      "type": "object",
      "properties": {
        "host": {
          "type": "string"
        },
        "port": {
          "type": ["integer", "string"]
        },
        "user": {
          "type": "string"
        },
        "password": {
          "type": "string"
        },
        "secure": {
          "type": ["string", "boolean"]
        },
        "sender": {
          "type": "string"
        },
        "insecureAuth": {
          "type": ["string", "boolean", "integer"]
        }
      },
      "additionalProperties": false
    },
    "fxa": {
      "type": "object",
      "properties": {
        "oauthServerUrl": {
          "type": "string"
        },
        "emailDomain": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string"
            },
            "tag": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "contentUrl": {
          "type": "string",
          "pattern": "^(https?://.+)?$"
        },
        "authUrl": {
          "type": "string",
          "pattern": "^(https?://.+)?$"
        },
        "profileUrl": {
          "type": "string",
          "pattern": "^(https?://.+)?$"
        },
        "signups": {
          "type": "string",
          "enum": ["open", "allowlist", "closed"]
        },
        "signupAllowlist": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "maxAccounts": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^(fixed:|initial:)?([0-9]+|unlimited)$"
            },
            {
              "type": "integer",
              "minimum": 0
            }
          ]
        },
        "accountEvents": {
          "type": ["string", "boolean"]
        },
        "clientAddressDepth": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "string",
              "pattern": "^[0-9]+$"
            }
          ]
        },
        "accessTokenLifetime": {
          "type": "string",
          "minLength": 1
        },
        "logLevel": {
          "type": "string",
          "minLength": 1
        },
        "adminClientId": {
          "type": "string",
          "pattern": "^([0-9a-f]{16})?$",
          "$comment": "the format oauth-clients.js enforces"
        },
        "adminClientSecret": {
          "type": "string",
          "pattern": "^([0-9a-f]{64})?$",
          "$comment": "the format oauth-clients.js enforces"
        },
        "extraCaCerts": {
          "type": "object",
          "properties": {
            "configMap": {
              "type": "string"
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "volumeOwnerInit": {
          "type": "boolean"
        },
        "networkPolicy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "servers": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "ingressController": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "namespaceSelector": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "matchLabels": {
                          "type": "object",
                          "additionalProperties": {
                            "type": "string"
                          }
                        },
                        "matchExpressions": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": ["key", "operator"],
                            "properties": {
                              "key": {"type": "string", "minLength": 1},
                              "operator": {"enum": ["In", "NotIn", "Exists", "DoesNotExist"]},
                              "values": {"type": "array", "items": {"type": "string"}}
                            }
                          }
                        }
                      }
                    },
                    "podSelector": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "matchLabels": {
                          "type": "object",
                          "additionalProperties": {
                            "type": "string"
                          }
                        },
                        "matchExpressions": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "additionalProperties": false,
                            "required": ["key", "operator"],
                            "properties": {
                              "key": {"type": "string", "minLength": 1},
                              "operator": {"enum": ["In", "NotIn", "Exists", "DoesNotExist"]},
                              "values": {"type": "array", "items": {"type": "string"}}
                            }
                          }
                        }
                      }
                    }
                  }
                },
                "extraFrom": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "minProperties": 1
                  }
                }
              }
            }
          }
        },
        "database": {
          "type": "object",
          "properties": {
            "backend": {
              "type": "string",
              "enum": ["mysql", "mariadb"]
            },
            "bundled": {
              "type": "boolean"
            },
            "allowMajorUpgrade": {
              "type": "boolean"
            },
            "image": {
              "type": "object",
              "required": ["mysql", "mariadb"],
              "properties": {
                "mysql": {
                  "type": "string",
                  "minLength": 1
                },
                "mariadb": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            },
            "external": {
              "type": "object",
              "properties": {
                "bootstrap": {
                  "$comment": "the account that applies the SQL of db/ at every start (docs/databases.md#let-the-stack-apply-them), its password in existingSecret; empty: only checked",
                  "type": "object",
                  "properties": {
                    "user": {
                      "type": "string",
                      "pattern": "^[A-Za-z0-9_]*$",
                      "maxLength": 32
                    }
                  },
                  "additionalProperties": false
                },
                "host": {
                  "type": "string"
                },
                "port": {
                  "$comment": "a number, or the same quoted (checked for 1-65535 at render time), or empty for 3306",
                  "oneOf": [
                    {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 65535
                    },
                    {
                      "type": "string",
                      "pattern": "^([0-9]{1,5})?$"
                    }
                  ]
                },
                "user": {
                  "type": "string",
                  "pattern": "^[a-z_][a-z0-9_]*$",
                  "maxLength": 32
                },
                "policyUser": {
                  "type": "string",
                  "pattern": "^([a-z_][a-z0-9_]*)?$",
                  "maxLength": 32
                }
              },
              "additionalProperties": false
            },
            "persistence": {
              "type": "object",
              "properties": {
                "size": {
                  "type": "string",
                  "pattern": "^[0-9]+([KMGTPE]i|[kMGTPE])?$"
                },
                "storageClass": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "resources": {
              "type": "object",
              "$comment": "a container's resources (requests, limits), as Kubernetes has them"
            }
          },
          "additionalProperties": false
        },
        "redis": {
          "type": "object",
          "properties": {
            "image": {
              "type": "string",
              "minLength": 1
            },
            "resources": {
              "type": "object",
              "$comment": "a container's resources (requests, limits), as Kubernetes has them"
            }
          },
          "additionalProperties": false
        },
        "keys": {
          "type": "object",
          "properties": {
            "existingSecret": {
              "type": "string"
            },
            "persistence": {
              "type": "object",
              "properties": {
                "size": {
                  "type": "string",
                  "pattern": "^[0-9]+([KMGTPE]i|[kMGTPE])?$"
                },
                "storageClass": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "profileImages": {
          "type": "object",
          "properties": {
            "persistence": {
              "type": "object",
              "properties": {
                "size": {
                  "type": "string",
                  "pattern": "^[0-9]+([KMGTPE]i|[kMGTPE])?$"
                },
                "storageClass": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "pairing": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "url": {
              "type": "string",
              "pattern": "^(wss?://.+)?$"
            },
            "image": {
              "type": "string"
            },
            "trustedProxies": {
              "type": "string"
            },
            "resources": {
              "type": "object",
              "$comment": "a container's resources (requests, limits), as Kubernetes has them"
            }
          },
          "additionalProperties": false
        },
        "resources": {
          "type": "object",
          "properties": {
            "auth": {
              "type": "object",
              "$comment": "a container's resources (requests, limits), as Kubernetes has them"
            },
            "content": {
              "type": "object",
              "$comment": "a container's resources (requests, limits), as Kubernetes has them"
            },
            "profile": {
              "type": "object",
              "$comment": "a container's resources (requests, limits), as Kubernetes has them"
            },
            "profileWorker": {
              "type": "object",
              "$comment": "a container's resources (requests, limits), as Kubernetes has them"
            },
            "profileStatic": {
              "type": "object",
              "$comment": "a container's resources (requests, limits), as Kubernetes has them"
            },
            "imgProxy": {
              "type": "object",
              "$comment": "a container's resources (requests, limits), as Kubernetes has them"
            },
            "init": {
              "type": "object",
              "$comment": "a container's resources (requests, limits), as Kubernetes has them"
            }
          },
          "additionalProperties": false
        },
        "ingress": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "className": {
              "type": "string"
            },
            "annotations": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "tls": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "secretNames": {
                  "type": "object",
                  "properties": {
                    "content": {
                      "type": "string"
                    },
                    "auth": {
                      "type": "string"
                    },
                    "profile": {
                      "type": "string"
                    },
                    "pairing": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": false
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "database": {
      "type": "object",
      "properties": {
        "backend": {
          "type": "string",
          "enum": ["mariadb", "mysql", "postgres"]
        },
        "bundled": {
          "type": "boolean"
        },
        "allowMajorUpgrade": {
          "type": "boolean"
        },
        "image": {
          "type": "object",
          "required": ["mariadb", "mysql", "postgres"],
          "properties": {
            "mariadb": {
              "type": "string",
              "minLength": 1
            },
            "mysql": {
              "type": "string",
              "minLength": 1
            },
            "postgres": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "postgresSyncUser": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_]*$",
          "maxLength": 32
        },
        "admin": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "pattern": "^[a-z_][a-z0-9_]*$",
              "maxLength": 32
            },
            "user": {
              "type": "string",
              "pattern": "^[a-z_][a-z0-9_]*$",
              "maxLength": 32
            },
            "syncUser": {
              "type": "string",
              "pattern": "^[a-z_][a-z0-9_]*$",
              "maxLength": 32
            }
          },
          "additionalProperties": false
        },
        "external": {
          "type": "object",
          "properties": {
            "bootstrap": {
              "$comment": "the account that applies the SQL of db/ at every start (docs/databases.md#let-the-stack-apply-them), its password in existingSecret; empty: only checked",
              "type": "object",
              "properties": {
                "user": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_]*$",
                  "maxLength": 32
                }
              },
              "additionalProperties": false
            },
            "host": {
              "type": "string"
            },
            "port": {
              "$comment": "a number, or the same quoted (checked for 1-65535 at render time), or empty for the backend's default port",
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                {
                  "type": "string",
                  "pattern": "^([0-9]{1,5})?$"
                }
              ]
            },
            "storageHost": {
              "type": "string"
            },
            "storagePort": {
              "$comment": "a number, or the same quoted (checked for 1-65535 at render time), or empty for the backend's default port",
              "oneOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 65535
                },
                {
                  "type": "string",
                  "pattern": "^([0-9]{1,5})?$"
                }
              ]
            },
            "tokenserverDatabase": {
              "type": "string",
              "pattern": "^[a-z_][a-z0-9_]*$",
              "maxLength": 32
            },
            "tokenserverUser": {
              "type": "string",
              "pattern": "^[a-z_][a-z0-9_]*$",
              "maxLength": 32
            },
            "storageDatabase": {
              "type": "string",
              "pattern": "^[a-z_][a-z0-9_]*$",
              "maxLength": 32
            },
            "storageUser": {
              "type": "string",
              "pattern": "^[a-z_][a-z0-9_]*$",
              "maxLength": 32
            },
            "postgresDatabase": {
              "type": "string",
              "pattern": "^[a-z_][a-z0-9_]*$",
              "maxLength": 32
            },
            "postgresUser": {
              "type": "string",
              "pattern": "^[a-z_][a-z0-9_]*$",
              "maxLength": 32
            },
            "tlsVerify": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        },
        "persistence": {
          "type": "object",
          "properties": {
            "size": {
              "type": "string",
              "pattern": "^[0-9]+([KMGTPE]i|[kMGTPE])?$"
            },
            "storageClass": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "resources": {
          "type": "object",
          "$comment": "a container's resources (requests, limits), as Kubernetes has them"
        }
      },
      "additionalProperties": false
    },
    "existingSecret": {
      "type": "string"
    },
    "nameOverride": {
      "type": "string"
    },
    "fullnameOverride": {
      "type": "string"
    },
    "syncstorage": {
      "type": "object",
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "resources": {
          "type": "object",
          "$comment": "a container's resources (requests, limits), as Kubernetes has them"
        },
        "service": {
          "type": "object",
          "properties": {
            "port": {
              "type": "integer"
            }
          },
          "additionalProperties": false
        },
        "initResources": {
          "type": "object",
          "$comment": "a container's resources (requests, limits), as Kubernetes has them"
        }
      },
      "additionalProperties": false
    },
    "admin": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "password": {
          "type": "string"
        },
        "alertEmail": {
          "type": "string"
        },
        "insecureCookie": {
          "type": ["string", "boolean", "integer"]
        },
        "oidc": {
          "type": "object",
          "properties": {
            "issuer": {
              "type": "string"
            },
            "clientId": {
              "type": "string"
            },
            "clientSecret": {
              "type": "string"
            },
            "redirectUrl": {
              "type": "string"
            },
            "scopes": {
              "type": "string"
            },
            "name": {
              "type": "string"
            },
            "groupsClaim": {
              "type": "string"
            },
            "trustUnverifiedEmail": {
              "type": ["string", "boolean"]
            }
          },
          "additionalProperties": false
        },
        "trustedHeader": {
          "type": "object",
          "properties": {
            "header": {
              "type": "string"
            },
            "groupsHeader": {
              "type": "string"
            },
            "trustedProxies": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "allowed": {
          "type": "object",
          "properties": {
            "users": {
              "type": "string"
            },
            "groups": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "notify": {
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "metricsToken": {
          "type": "string"
        },
        "tz": {
          "type": "string"
        },
        "publicCheck": {
          "type": ["string", "boolean"]
        },
        "updateCheck": {
          "type": ["string", "boolean"]
        },
        "staleDays": {
          "type": "integer",
          "minimum": 0
        },
        "retentionDays": {
          "type": "integer",
          "minimum": 0
        },
        "auditRetentionDays": {
          "type": "integer",
          "minimum": 0
        },
        "purge": {
          "type": ["string", "integer"]
        },
        "errorRatePercent": {
          "type": "integer",
          "minimum": 0
        },
        "errorRateMinErrors": {
          "type": "integer",
          "minimum": 0
        },
        "dbGrowthMb": {
          "type": "integer",
          "minimum": 0
        },
        "dbGrowthFactor": {
          "type": "integer",
          "minimum": 0
        },
        "deleteUnconfirmedDays": {
          "type": ["string", "integer"]
        },
        "unconfirmedHours": {
          "anyOf": [
            {"type": "integer", "minimum": 0, "maximum": 999999},
            {"type": "string", "pattern": "^([0-9]{1,6})?$"}
          ]
        },
        "signupBurst": {
          "type": "integer",
          "minimum": 0
        },
        "resources": {
          "type": "object",
          "$comment": "a container's resources (requests, limits), as Kubernetes has them"
        },
        "ingress": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "className": {
              "type": "string"
            },
            "host": {
              "type": "string"
            },
            "tls": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "secretName": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            },
            "annotations": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "additionalProperties": false
        },
        "fxaSignIn": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "backup": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "schedule": {
          "type": "string",
          "minLength": 1
        },
        "keep": {
          "type": "integer",
          "minimum": 1
        },
        "activeDeadlineSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "persistence": {
          "type": "object",
          "properties": {
            "size": {
              "type": "string",
              "pattern": "^[0-9]+([KMGTPE]i|[kMGTPE])?$"
            },
            "storageClass": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "resources": {
          "type": "object",
          "$comment": "a container's resources (requests, limits), as Kubernetes has them"
        }
      },
      "additionalProperties": false
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "host": {
          "type": "string"
        },
        "tls": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "secretName": {
              "type": "string"
            }
          },
          "additionalProperties": false
        },
        "annotations": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "global": {
      "type": "object",
      "$comment": "Helm's global values (of a parent chart), not read"
    },
    "imagePullSecrets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "nodeSelector": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "tolerations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "affinity": {
      "type": "object"
    },
    "podAnnotations": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
